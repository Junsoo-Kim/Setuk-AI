# version_C/.env로 복사한 뒤 실제 값을 채우세요. 이 파일(.env)은 .gitignore로 추적되지 않습니다.

# 필수: 교사 개인 Anthropic API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 기본은 품질 우선 모델(claude-opus-5)입니다. 비용을 낮추려면 claude-sonnet-5로 바꾸세요.
ANTHROPIC_MODEL=claude-opus-5

# 선택: 에이전트 응답의 최대 토큰 수
ANTHROPIC_MAX_TOKENS=8000

# 선택: Flask 세션 서명 키. 미설정이면 프로세스마다 무작위로 생성되어 서버를
# 재시작할 때마다 로그인이 풀립니다. 학교 단위로 여러 인스턴스를 띄우거나
# 재시작 후에도 로그인을 유지하려면 고정값을 넣으세요.
#   python -c "import secrets; print(secrets.token_hex(32))"
# SETUK_SECRET_KEY=

# ---------------------------------------------------------------------------
# 저장소
# ---------------------------------------------------------------------------
# 작업 목록·검토 이력·감사 로그를 담는 데이터베이스.
# 미설정이면 version_C/setuk_c.sqlite3 (혼자 쓰는 로컬 기본값)를 씁니다.
# PostgreSQL로 바꾸면 LangGraph 체크포인터도 자동으로 PostgresSaver로 전환되고,
# 규정 검색도 자체 BM25 대신 PostgreSQL FTS + pgvector를 쓴다(pgvector 확장·
# pgvector 파이썬 패키지 필요, `alembic upgrade head`로 policy_chunks 테이블 생성).
# DATABASE_URL=postgresql+psycopg://setuk:비밀번호@localhost:5432/setuk

# 선택: SQLite 체크포인트 파일 위치(기본 version_C/run_state_c.sqlite3).
# PostgreSQL을 쓰면 이 값은 무시됩니다.
# SETUK_CHECKPOINT_PATH=

# ---------------------------------------------------------------------------
# 개인정보·관측성
# ---------------------------------------------------------------------------
# 가명 ID(stu_xxxxxxxx) 생성에 쓰는 솔트. 고정해야 학기가 바뀌어도 같은 학생이
# 같은 가명으로 남습니다. 미설정이면 프로세스마다 달라집니다.
# 이 값이 유출되면 가명에서 실명을 역추적할 수 있으므로 .env 밖으로 내보내지 마세요.
# SETUK_PSEUDONYM_SALT=

# 감사 로그에 남길 검토자 식별자. 여러 교사가 한 서버를 쓴다면 인증 도입 전까지의 임시값입니다.
# SETUK_REVIEWER=local-teacher

# DB에 저장되는 학생 실명·초안 본문·산출물·가명 매핑을 암호화합니다.
# Fernet 키(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")를
# 붙여넣으세요. 미설정이면 평문 저장이며, 키를 바꾸거나 지우면 기존에 암호화된 값은 읽을 수 없습니다.
# SETUK_DB_ENCRYPTION_KEY=

# 1로 두면 프롬프트·응답 전문을 로그에 남깁니다. 학생 초안이 그대로 찍히므로
# 기본은 끄고, 계약 파싱 실패를 디버깅할 때만 잠깐 켜세요.
# SETUK_LOG_RAW_LLM=0

# ---------------------------------------------------------------------------
# 규정 RAG
# ---------------------------------------------------------------------------
# 이 실행에 적용할 학년도. 미설정이면 코퍼스에 있는 최신 학년도를 씁니다.
# 지난 학년도 자료를 다시 만들 때만 과거 연도로 고정하세요.
# SETUK_POLICY_YEAR=2026

# dense 검색 제공자. 기본은 none(BM25 + 정확 일치만 사용)입니다.
# 규정 검색은 조항 번호·금칙 용어처럼 정확 일치가 결정적이라 기본값으로도 실용적입니다.
# none | voyage | openai
# SETUK_EMBEDDING_PROVIDER=none
# SETUK_EMBEDDING_MODEL=voyage-3
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# MCP 도구 서버
# ---------------------------------------------------------------------------
# 쓰기 도구(submit_review) 허용 여부. 교사의 승인을 대신 기록하는 도구이므로
# 기본은 차단입니다. 평소에는 웹 화면에서 직접 승인하세요.
# SETUK_MCP_ALLOW_WRITE=0

# ---------------------------------------------------------------------------
# 보존 기간과 비용 상한
# ---------------------------------------------------------------------------
# 초안·산출물을 며칠 뒤에 자동 삭제할지. 0(기본)이면 자동 삭제하지 않습니다.
# 학교 보존 정책에 맞춰 정하세요. 개별 항목을 따로 지정할 수도 있습니다.
# SETUK_RETENTION_DAYS=365
# SETUK_RETENTION_DRAFT_DAYS=
# SETUK_RETENTION_ARTIFACT_DAYS=
# 감사 로그는 삭제 사실의 증거이므로 기본 무기한입니다.
# SETUK_RETENTION_AUDIT_DAYS=0

# 작업 한 건이 쓸 수 있는 토큰 상한. 0/미설정이면 제한하지 않습니다.
# 반려 재작성과 Linter 재시도가 겹치면 한 학생에 LLM을 십수 번 부를 수 있습니다.
# SETUK_MAX_TOKENS_PER_RUN=200000

# MCP 도구 하나가 클라이언트를 붙잡아 둘 수 있는 최대 시간(초).
# 파이썬은 실행 중인 스레드를 죽일 수 없으므로 이건 클라이언트의 대기를 끊는 것이지
# 작업 자체를 중단시키지 않습니다.
# SETUK_MCP_TIMEOUT_SECONDS=30

# MCP 도구 응답의 최대 크기. 큰 DOCX 하나가 에이전트 컨텍스트를 통째로 태우는 것을 막습니다.
# MAX_RESULT_BYTES는 전체 응답(JSON 직렬화 기준)의 최종 상한이고, 넘으면 잘라내지 않고
# 거부합니다. MAX_TEXT_CHARS는 extract_docx 같은 도구가 본문을 미리 자르는 기준입니다.
# SETUK_MCP_MAX_RESULT_BYTES=262144
# SETUK_MCP_MAX_TEXT_CHARS=40000
